  #     content = "TODO.rb",
  #     font = "tb-8",
  #     color = "#ffffff"
  #   )
  # )

  # birthday = days_until_event(2026, 5, 2, timezone, french, "BIRTHDAY")
  birthday = False
  if birthday:
    bottom_row_items.append(
      render.Text(
        content = birthday,
        font = "tb-8",
        color = "#BF40BF"
      )
    )

  rows.append(
    render.Padding(
      pad = (0, 4, 0, 0),
      child = render.Row(
        children = bottom_row_items,
        expanded = True,
        main_align = "space_evenly",
      )
    )
  )

  return render.Root(
    child = render.Box(
      padding = 0,
      child = render.Column(
        expanded = True,
        cross_align = "center",
        children = rows,
      ),
    ),
  )


def formatted_temperature(input):
  temp = int(input)
  if temp < 0:
    return "%s°" % temp
  else:
    return " %s°" % temp

def days_until_event(year, month, day, timezone, french = False, message = "Today!"):
  now = time.now().in_location(timezone)
  d = time.time(year = year, month = month, day = day, hour = 0, minute = 0, second = 0, nanosecond = 0, location = timezone)
  result = math.floor((d.unix - now.unix) / (60 * 60 * 24)) + 1

  if result < 0:
    return None
  elif result == 0:
    return message
  elif result == 1:
    if french:
      return "1 jour"
    else:
      return "1 day"
  else:
    if french:
      return "%s jours" % result
    else:
      return "%s days" % result

# English fuzzy time

def fuzzy_time_lines(now):
  hour = now.hour
  next_hour = (now.hour + 1) % 24
  result = []

  if now.minute <= 1 or (now.minute == 2 and now.second <= 30):
    result = [hour_word(hour)]
  elif now.minute <= 6 or (now.minute == 7 and now.second <= 30):
    result = ["just after", hour_word(hour)]
  elif now.minute <= 11 or (now.minute == 12 and now.second <= 30):
    result = ["ten after", hour_word(hour)]
  elif now.minute <= 16 or (now.minute == 17 and now.second <= 30):
    result = ["quarter after", hour_word(hour)]
  elif now.minute <= 21 or (now.minute == 22 and now.second <= 30):
    result = ["twenty after", hour_word(hour)]
  elif now.minute <= 26 or (now.minute == 27 and now.second <= 30):
    result = ["almost", "%s thirty" % hour_word(hour, True) ]
  elif now.minute <= 31 or (now.minute == 32 and now.second <= 30):
    result = [hour_word(hour, True), "thirty"]
  elif now.minute <= 36 or (now.minute == 37 and now.second <= 30):
    result = [hour_word(hour, True), "thirty five"]
  elif now.minute <= 41 or (now.minute == 42 and now.second <= 30):
    result = ["twenty to", hour_word(next_hour)]
  elif now.minute <= 46 or (now.minute == 47 and now.second <= 30):
    result = ["quarter to", hour_word(next_hour)]
  elif now.minute <= 51 or (now.minute == 52 and now.second <= 30):
    result = ["ten to", hour_word(next_hour)]
  elif now.minute <= 56 or (now.minute == 57 and now.second <= 30):
    result = ["almost", hour_word(next_hour)]
  elif now.minute <= 59:
    result = [hour_word(next_hour)]
  else:
    result = ["%s-ish" % hour_word(hour)]

  # Turn two lines into one if they're short
  if len(result) == 2:
    str = " ".join(result)
    if len(str) <= 10:
      result = [str]

  return result

def hour_word(hour, numeric_twelve = False):
  if hour == 0:
    if numeric_twelve:
      return "twelve"
    else:
      return "midnight"
  elif hour == 12:
    if numeric_twelve:
      return "twelve"
    else:
      return "noon"
  elif hour > 12:
    return hour_word(hour - 12)
  elif hour == 1:
    return "one"
  elif hour == 2:
    return "two"
  elif hour == 3:
    return "three"
  elif hour == 4:
    return "four"
  elif hour == 5:
    return "five"
  elif hour == 6:
    return "six"
  elif hour == 7:
    return "seven"
  elif hour == 8:
    return "eight"
  elif hour == 9:
    return "nine"
  elif hour == 10:
    return "ten"
  elif hour == 11:
    return "eleven"
  else:
    return "???"

# French fuzzy time

def fuzzy_time_lines_fr(now):
  hour = now.hour
  next_hour = (now.hour + 1) % 24

  if now.minute <= 1 or (now.minute == 2 and now.second <= 30):
    return ["%s %s" % (hour_word_fr(hour), hour_plural_fr(hour))]
  elif now.minute <= 6 or (now.minute == 7 and now.second <= 30):
    return ["juste après", "%s %s" % (hour_word_fr(hour), hour_plural_fr(hour))]
  elif now.minute <= 11 or (now.minute == 12 and now.second <= 30):
    return ["%s %s" % (hour_word_fr(hour), hour_plural_fr(hour)), "et dix"]
  elif now.minute <= 16 or (now.minute == 17 and now.second <= 30):
    return ["%s %s" % (hour_word_fr(hour), hour_plural_fr(hour)), "et quart"]
  elif now.minute <= 21 or (now.minute == 22 and now.second <= 30):
    return ["%s %s" % (hour_word_fr(hour), hour_plural_fr(hour)), "et vingt"]
  elif now.minute <= 26 or (now.minute == 27 and now.second <= 30):
    return ["presque %s" % hour_word_fr(hour), "%s et demi" % hour_plural_fr(hour)]
  elif now.minute <= 31 or (now.minute == 32 and now.second <= 30):
    return ["%s %s" % (hour_word_fr(hour), hour_plural_fr(hour)), "et demi" ]
  elif now.minute <= 36 or (now.minute == 37 and now.second <= 30):
    return ["%s %s" % (hour_word_fr(hour), hour_plural_fr(hour)), "trente-cinq" ]
  elif now.minute <= 41 or (now.minute == 42 and now.second <= 30):
    return ["%s %s" % (hour_word_fr(next_hour), hour_plural_fr(next_hour)), "moins vingt"]
  elif now.minute <= 46 or (now.minute == 47 and now.second <= 30):
    return ["%s %s" % (hour_word_fr(next_hour), hour_plural_fr(next_hour)), "moins quart"]
  elif now.minute <= 51 or (now.minute == 52 and now.second <= 30):
    return ["%s %s" % (hour_word_fr(next_hour), hour_plural_fr(next_hour)), "moins dix"]
  elif now.minute <= 56 or (now.minute == 57 and now.second <= 30):
    return ["presque", "%s %s" % (hour_word_fr(next_hour), hour_plural_fr(next_hour))]
  elif now.minute <= 59:
    return ["%s %s" % (hour_word_fr(next_hour), hour_plural_fr(next_hour))]
  else:
    return ["%s-ish" % hour_word_fr(hour)]

def hour_word_fr(hour, numeric_twelve = False):
  if hour == 0:
    return "minuit"
  elif hour == 12:
    return "midi"
  elif hour > 12:
    return hour_word_fr(hour - 12)
  elif hour == 1:
    return "une"
  elif hour == 2:
    return "deux"
  elif hour == 3:
    return "trois"
  elif hour == 4:
    return "quatre"
  elif hour == 5:
    return "cinq"
  elif hour == 6:
    return "six"
  elif hour == 7:
    return "sept"
  elif hour == 8:
    return "huit"
  elif hour == 9:
    return "neuf"
  elif hour == 10:
    return "dix"
  elif hour == 11:
    return "onze"
  else:
    return "???"

def hour_plural_fr(hour):
  if hour == 0 or hour == 12:
    return ""
  elif hour == 1 or hour == 13:
    return "heure"
  else:
    return "heures"
