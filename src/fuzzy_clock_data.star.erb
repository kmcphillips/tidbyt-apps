DATA = <%= data_as_starlark_dict %>

def main(config):
  timezone = config.get("timezone") or "America/New_York"
  french = True
  now = time.now().in_location(timezone)
  color = "#c7cafe"
  rows = [render.Box(height = 2)]
  if french:
    lines = fuzzy_time_lines_fr(now)
  else:
    lines = fuzzy_time_lines(now)

  if len(lines) == 2:
    rows.append(
      render.Text(
        content = lines[0].strip().capitalize(),
        font = "tb-8",
        color = color,
      ),
    )
    rows.append(
      render.Text(
        content = lines[1],
        font = "tb-8",
        color = color,
      ),
    )

  else:
    if len(lines) == 1:
      line = lines[0]
    else:
      line = "Bad line len = %d" % len(lines)

    rows.append(
      render.Padding(
        pad = (0, 4, 0, 4),
        child = render.Text(
          content = line.capitalize(),
          font = "tb-8",
          color = color,
        ),
      ),
    )

  bottom_row_items = [
    render.Text(
          content = formatted_temperature(DATA["temperature"]),
          font = "tb-8",
          color = "#ffffff"
    )
  ]

  ## Add custom things here
  # bottom_row_items.append(
